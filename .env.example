# Path to the copilot binary. Override if not on PATH.
COPILOT_BIN=copilot

# Default maximum debate rounds (overridden by --rounds flag).
MAX_ROUNDS=8

# Default per-turn timeout in seconds (overridden by --timeout flag).
AGENT_TIMEOUT=120

# Max number of agents that send their opening statement simultaneously.
OPENING_BATCH_SIZE=10

# Default provider: "copilot" or "ollama" (prompted interactively if omitted).
# PROVIDER=copilot

# Ollama settings (only used when PROVIDER=ollama or --provider ollama).
# OLLAMA_MODEL=hf.co/DavidAU/Qwen2.5-QwQ-35B-Eureka-Cubed-abliterated-uncensored-gguf:Q8_0
# OLLAMA_URL=http://localhost:11434
